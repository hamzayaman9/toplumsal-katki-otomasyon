# Veritabanı (test: SQLite; sunucuda postgresql+psycopg://... olabilir)
DATABASE_URL=sqlite:///data/katki.db

# OpenRouter (anahtar sistem ortam değişkeninden de okunur)
# OPENROUTER_API_KEY=
# jev: kararlar Jev'den (typesafe/jev-1.13); özet/paydaş yalnız katkılar için LLM'den | llm: her şey LLM'den
CLASSIFIER=jev
JEV_MODEL=typesafe/jev-1.13
# Özet/paydaş (CLASSIFIER=llm ise tüm sınıflandırma) için model
LLM_MODEL=openai/gpt-6-luna
# off: akıl yürütme (reasoning) tokenları kapalı
LLM_REASONING=off

# Tarayıcı
USER_AGENT=AU-ToplumsalKatki-Bot/0.1 (+Ankara Universitesi Toplumsal Katki Koordinatorlugu)
# respect: robots.txt Disallow kurallarına uy | ignore: Disallow'u yok say (Crawl-delay yine uygulanır)
ROBOTS_POLICY=ignore
MIN_HOST_DELAY=2
MAX_CRAWL_DELAY=10
CONCURRENCY=5
